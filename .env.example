# Copie para .env e troque todos os valores de exemplo antes de iniciar.
APP_ENV=development
APP_SECRET_KEY=COLOQUE_AQUI_UMA_CHAVE_ALEATORIA_DE_PELO_MENOS_32_CARACTERES
COOKIE_SECURE=false

# Credenciais do app para MySQL (não use o usuário root no aplicativo)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=aethermind
MYSQL_USER=aethermind_app
MYSQL_PASSWORD=MUDE_ESTA_SENHA
MYSQL_POOL_SIZE=5

# Usados apenas pelo Docker Compose para inicializar o MySQL local
MYSQL_ROOT_PASSWORD=MUDE_A_SENHA_ROOT
